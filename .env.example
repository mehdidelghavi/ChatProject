# Copy to .env before the first `docker compose up`.
#
#   cp .env.example .env
#
# Compose reads this file for ${...} interpolation AND injects it into the app
# container through `env_file`, so one file drives both.

# ---- Application ----
# app.js reads the lowercase `port`
port = 3000

# Absolute URL the BROWSER uses for the Socket.IO connection and redirects.
# This is the nginx address, not the app's port. Must match DOMAIN below.
HOST = https://localhost

# ---- Database ----
# `db` is the service name in docker-compose.db.yml, resolved over chat_network.
# Use host.docker.internal to point at a MySQL running on the host instead.
DB_HOST = db
DB_USER = chat
DB_PASSWORD = chatsecret
DB_DBNAME = chat

# Only consumed by docker-compose.db.yml when the volume is first created.
DB_ROOT_PASSWORD = rootsecret

# ---- Auth ----
# Generate with: openssl rand -hex 32
JWT_SECRET = change-me

# ---- Reverse proxy / TLS ----
# The public hostname. `localhost` keeps the stack on a self-signed certificate.
# On a server set this to the real, publicly resolvable domain.
DOMAIN = localhost

# selfsigned  -> works anywhere, browser shows a warning
# letsencrypt -> real certificate, needs a public DOMAIN and port 80 open
SSL_MODE = selfsigned

# Required when SSL_MODE=letsencrypt. Used for expiry warnings.
LETSENCRYPT_EMAIL =

# Keep `true` until the whole flow works: the production endpoint allows only
# 5 failed issuance attempts per hour, staging is effectively unlimited.
LETSENCRYPT_STAGING = true

# Host ports nginx publishes. Leave at 80/443 on a server — Let's Encrypt only
# validates over public port 80. Change them only when something else on the
# machine already owns those ports.
HTTP_PORT = 80
HTTPS_PORT = 443

# Leave empty when HTTPS_PORT is 443. Otherwise set to ":<port>" with the
# leading colon, e.g. ":8443", so the HTTP->HTTPS redirect targets it.
HTTPS_PUBLIC_SUFFIX =
